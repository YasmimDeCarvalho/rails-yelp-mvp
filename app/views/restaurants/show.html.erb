<div class="container py-4">

  <%= link_to "← Back to all restaurants", restaurants_path,
      class: "btn btn-outline-secondary mb-4" %>

  <!-- Restaurant information -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">

      <div class="d-flex justify-content-between align-items-center">
        <h2 class="fw-bold mb-0"><%= @restaurant.name %></h2>

        <span class="badge bg-primary rounded-pill">
          <%= @restaurant.category.capitalize %>
        </span>
      </div>

      <hr>

      <p class="text-secondary mb-2">
        <strong>Address:</strong> <%= @restaurant.address %>
      </p>

      <p class="text-secondary mb-0">
        <strong>Phone:</strong> <%= @restaurant.phone_number %>
      </p>

    </div>
  </div>

  <div class="row g-4">

    <!-- Reviews -->
    <div class="col-12 col-md-6">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

          <h3 class="fw-bold mb-4">
            Reviews
            <span class="badge bg-light text-dark">
              <%= @reviews.count %>
            </span>
          </h3>

          <% if @reviews.empty? %>
            <p class="text-muted">No reviews yet.</p>
          <% end %>

          <% @reviews.each do |review| %>
            <div class="border-bottom pb-3 mb-3">

              <div class="fs-5 mb-2">
                <span class="text-warning">
                  <%= "★" * review.rating %>
                </span>
                <span class="text-secondary opacity-25">
                  <%= "★" * (5 - review.rating) %>
                </span>
              </div>

              <p class="text-secondary mb-0">
                <%= review.content %>
              </p>

            </div>
          <% end %>

        </div>
      </div>
    </div>

    <!-- Review form -->
    <div class="col-12 col-md-6">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

          <h3 class="fw-bold mb-4">Leave a review</h3>

          <%= simple_form_for [@restaurant, @review] do |f| %>
            <%= f.error_notification %>

            <%= f.input :content,
                placeholder: "Share your experience...",
                input_html: { rows: 4 } %>

            <%= f.input :rating,
                collection: 0..5,
                prompt: "Select a rating" %>

            <%= f.submit "Add Review",
                class: "btn btn-primary w-100 mt-2" %>
          <% end %>

        </div>
      </div>
    </div>

  </div>
</div>
